// ==UserScript==
// @name         숲 핀볼게임 수집기 (SOOP)
// @namespace    soop-roulette-collector
// @version      3.3.6
// @description  숲(SOOP) 채팅에서 별풍선/도전미션/대결미션 후원을 추적해, 내장된 마블 룰렛(핀볼) 게임 창에 참가자를 실시간으로 쌓는다. 닉네임 수집 / 채팅 수집 두 모드 지원.
// @author       버먼
// @match        https://play.sooplive.co.kr/*
// @match        https://play.sooplive.com/*
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_addValueChangeListener
// @grant        GM_registerMenuCommand
// @grant        unsafeWindow
// @grant        GM_xmlhttpRequest
// @connect      live.sooplive.co.kr
// @connect      sooplive.com
// @connect      sooplive.co.kr
// @connect      profile.img.sooplive.co.kr
// @run-at       document-start
// ==/UserScript==

/*
 * 사용법
 * 1) 숲 방송 페이지에서 템퍼몽키 아이콘 → "🎡 설정 열기/닫기"로 설정창을 연다.
 * 2) 모드/수집 대상/티켓 계산을 설정하고 [수집 시작]을 누르면
 *    핀볼(마블 룰렛) 게임 창이 새로 열리고, 이후 별풍선이 올 때마다
 *    게임 입력칸에 "닉네임*개수"로 실시간 반영된다.
 *
 * 게임은 lazygyu의 Marble Roulette(MIT, github.com/lazygyu/roulette)를
 * 빌드해 스크립트 안에 통째로 내장한 것 — 인터넷 접속 없이 동작한다.
 *
 * 티켓 계산 예) 별풍선 50개당 1개 + 보너스 "티켓 10개당 +1" 설정 시
 *   2000개 후원 → 기본 40 + 보너스 4 = 닉네임*44
 */

(function () {
  'use strict';

  // ---------- 공용 상수 / 유틸 ----------
  const K = {
    cfg: 'src_cfg',
    running: 'src_running',
    entries: 'src_entries', // [{name, count}]
    sync: 'src_sync', // {ts, text}
    log: 'src_log', // {ts, msg}
    stats: 'src_stats', // {balloons, events}
    heartbeat: 'src_heartbeat', // 게임 창이 살아있음을 알리는 하트비트 (탭 간 세션 유지)
  };

  const DEFAULT_CFG = {
    mode: 'nick', // 'nick' | 'chat'
    srcBalloon: true,
    srcChallenge: true,
    srcBattle: true,
    srcAdballoon: true, // 애드벌룬
    perTicket: 100,
    bonusOn: false,
    bonusEvery: 10,
    bonusAdd: 1,
    chatWaitSec: 60,
    chatFallbackNick: true,
    maxChatLen: 30,
    timerOn: false, // 수집 타이머
    timerMin: 1,
    timerSec: 0,
    confirmClose: true, // 게임 창 닫기 전 확인
    simOn: false, // 테스트: 랜덤 별풍선 자동 발사
    hapbangOn: false, // 합방 수집(멤버 채팅 직접 접속) 모드
    hapbangIds: [], // 합방 수집 대상 멤버 아이디 목록
  };

  // ---------- 합방 수집: 장지수용소 멤버 / 채팅 프로토콜 ----------
  const HAPBANG_MEMBERS = [
    { nick: '장지수', id: 'iamquaddurup' },
    { nick: '냥냥두둥', id: 'doodong' },
    { nick: '시몽', id: 'ximong' },
    { nick: '후룽카카', id: 'kakazzang' },
    { nick: '포포', id: 'sunza1122' },
    { nick: '구월이', id: 'isq1158' },
    { nick: '린링', id: 'mini1212' },
    { nick: '유오늘', id: 'youoneul' },
    { nick: '하빵', id: 'habbang2' },
    { nick: '히루룽', id: 'hey092130' },
    { nick: '고춘자', id: 'lilgochun' },
    { nick: '비비안', id: '8bibian8' },
    { nick: '김메이', id: 'amanemay' },
    { nick: '이치유', id: 'honoe1330' },
  ].map((m) => ({ ...m, img: 'https://profile.img.sooplive.co.kr/LOGO/' + m.id.slice(0, 2) + '/' + m.id + '/' + m.id + '.jpg' }));

  // 숲 채팅 패킷: ESC(0x1b)+TAB(0x09) + 서비스코드(4) + 본문바이트길이(6) + "00" + 본문(\f 구분)
  // (halfdogs/soopchat · zzik2/soop4j · w0lfv/SoopChatNet 교차검증, 라이브 실측 확인)
  const HB_ESC = '\x1b\t';
  const HB_F = '\x0c';
  const HB_ENC = new TextEncoder();
  function hbPkt(svc, body) {
    const len = HB_ENC.encode(body).length; // 본문 UTF-8 바이트 길이
    return HB_ESC + String(svc).padStart(4, '0') + String(len).padStart(6, '0') + '00' + body;
  }
  // 한 프레임에 여러 패킷이 붙어올 수 있어 ESC+TAB 경계로 분리
  function hbSplit(s) {
    const out = [];
    let i = s.indexOf(HB_ESC);
    while (i >= 0) {
      const n = s.indexOf(HB_ESC, i + 2);
      out.push(s.slice(i, n < 0 ? s.length : n));
      i = n;
    }
    return out;
  }

  function getCfg() {
    return Object.assign({}, DEFAULT_CFG, GM_getValue(K.cfg, {}));
  }
  function getEntries() {
    return GM_getValue(K.entries, []);
  }
  function buildText(entries) {
    return entries.map((e) => (e.count > 1 ? `${e.name}*${e.count}` : e.name)).join(',');
  }
  // 룰렛이 , * / 개행을 문법으로 쓰므로 이름에서 제거
  function sanitizeName(s) {
    return (s || '').replace(/[,*/\r\n]+/g, ' ').replace(/\s{2,}/g, ' ').trim();
  }
  // 닉네임 뒤에 붙는 중복 카운터 "(2)" 꼬리표만 제거
  function cleanNick(s) {
    return sanitizeName(String(s || '').replace(/\s*\(\d+\)\s*$/, ''));
  }
  // 채팅 요소에서 순수 문구만 추출 — "번역" 버튼 등 부가 요소 텍스트 제외
  function extractMsg(msgEl) {
    const clone = msgEl.cloneNode(true);
    clone.querySelectorAll('button, a, [class*="translat"], [class*="btn"]').forEach((el) => el.remove());
    return sanitizeName(clone.textContent).replace(/\s*번역\s*$/, '');
  }
  function log(msg) {
    let list = GM_getValue(K.log, []);
    if (!Array.isArray(list)) list = [];
    list.push({ ts: Date.now(), msg: String(msg) });
    while (list.length > 40) list.shift();
    GM_setValue(K.log, list);
  }
  function calcTickets(cfg, amount) {
    const per = Math.max(1, Number(cfg.perTicket) || 1);
    const base = Math.floor(amount / per);
    let bonus = 0;
    if (cfg.bonusOn && Number(cfg.bonusEvery) > 0) {
      bonus = Math.floor(base / Number(cfg.bonusEvery)) * (Number(cfg.bonusAdd) || 0);
    }
    return base + bonus;
  }
  function addEntry(name, count) {
    name = sanitizeName(name);
    if (!name || count <= 0) return;
    const entries = getEntries();
    const found = entries.find((e) => e.name === name);
    if (found) found.count += count;
    else entries.push({ name, count });
    GM_setValue(K.entries, entries);
    GM_setValue(K.sync, { ts: Date.now(), text: buildText(entries) });
  }
  function bumpStats(amount) {
    const s = GM_getValue(K.stats, { balloons: 0, events: 0 });
    s.balloons += amount;
    s.events += 1;
    GM_setValue(K.stats, s);
  }


  // ==========================================================
  // A0. 숲 채팅 웹소켓 후킹 — 화면 파싱보다 정확한 1차 감지 경로
  //   프로토콜 참고: halfdogs/soopchat (wakscord/afreeca)
  //   프레임 = ESC 0x09 + 서비스코드(4자리) + ... , 필드 구분자 \f
  //   svc 18 = 별풍선(필드3=닉네임, 필드4=개수), svc 5 = 채팅, svc 121 = 미션(JSON)
  // ==========================================================
  function dedupKey(nick, amount, type) {
    return `${nick}|${amount}|${type}`;
  }

  function socketDonation(nick, amount, type) {
    if (!isRunning()) return;
    if (getCfg().hapbangOn) return; // 합방 모드에선 직접접속 소켓만 사용
    const key = dedupKey(nick, amount, type);
    const now = Date.now();
    while (recentDonations.length && now - recentDonations[0].ts > 10000) recentDonations.shift();
    if (recentDonations.some((d) => d.key === key)) return;
    recentDonations.push({ key, ts: now });
    handleDonation(nick, amount, type);
  }

  function socketChat(nick, msgTxt) {
    if (getCfg().hapbangOn) return;
    if (!isRunning() || pendingChat.size === 0 || !pendingChat.has(nick)) return;
    const p = pendingChat.get(nick);
    if (Date.now() > p.expires) return;
    const cfg = getCfg();
    const m = msgTxt.slice(0, Number(cfg.maxChatLen) || 30);
    if (!m) return;
    pendingChat.delete(nick);
    addEntry(m, p.tickets);
    log(`${nick} 채팅 수집 → "${m}"*${p.tickets}`);
  }

  function processPacket(str) {
    if (!str || str.length < 6) return;
    const svc = parseInt(str.slice(2, 6), 10);
    if (!Number.isFinite(svc)) return;
    const f = str.split('\f');
    if (svc === 18) {
      // 별풍선
      const nick = cleanNick(f[3] || '');
      const amount = parseInt(f[4], 10);
      if (nick && amount > 0) socketDonation(nick, amount, 'balloon');
      else log('별풍선 패킷 해석 실패: ' + str.replace(/[\x00-\x1f]/g, '|').slice(0, 90));
    } else if (svc === 121) {
      // 도전/대결 미션 (JSON 페이로드)
      try {
        const j = JSON.parse(f[1]);
        const nick = cleanNick(j.user_nick || j.user_id || '');
        const amount = Number(j.gift_count) || 0;
        const hint = String(j.mission_type || j.type || '') + ' ' + String(j.title || '');
        const type = /battle|대결/i.test(hint) ? 'battle' : 'challenge';
        if (nick && amount > 0) socketDonation(nick, amount, type);
      } catch (e) {
        /* JSON 아닌 미션 패킷 무시 */
      }
    } else if (svc === 87) {
      // 애드벌룬 (필드4=닉네임, 필드10=개수)
      const nick = cleanNick(f[4] || '');
      const amount = parseInt(f[10], 10);
      if (nick && amount > 0) socketDonation(nick, amount, 'adballoon');
    } else if (svc === 5) {
      // 일반 채팅 — 채팅 수집 모드 매칭용 (필드1=내용, 필드6=닉네임)
      const nick = cleanNick(f[6] || '');
      const msgTxt = sanitizeName(f[1] || '');
      if (nick && msgTxt) socketChat(nick, msgTxt);
    }
  }

  function handleSocketFrame(data) {
    try {
      if (typeof data === 'string') processPacket(data);
      else if (data instanceof ArrayBuffer) processPacket(new TextDecoder('utf-8').decode(data));
      else if (data && typeof data.text === 'function') data.text().then(processPacket).catch(() => {});
    } catch (e) {
      /* ignore */
    }
  }

  function hookWebSocket() {
    const W = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;
    const Native = W.WebSocket;
    if (!Native || Native.__srcHooked) return;
    const Wrapped = function (url, protocols) {
      const ws = protocols !== undefined ? new Native(url, protocols) : new Native(url);
      try {
        ws.addEventListener('message', (ev) => handleSocketFrame(ev.data));
      } catch (e) {
        /* ignore */
      }
      return ws;
    };
    Wrapped.prototype = Native.prototype;
    for (const k of ['CONNECTING', 'OPEN', 'CLOSING', 'CLOSED']) Wrapped[k] = Native[k];
    Wrapped.__srcHooked = true;
    try {
      W.WebSocket = Wrapped;
    } catch (e) {
      /* ignore */
    }
  }
  hookWebSocket();

  // ==========================================================
  // A. 숲 방송 페이지 — 후원 감지 (모든 프레임에서 동작)
  // ==========================================================
  // 알림 문구 예: "○○○님이 별풍선 100개를 선물했습니다!" / "강남한이 별풍선 1,000개" (배너형)
  const BALLOON_HINT = /별풍선|애드벌룬/;
  const ACTION_RE = /선물|후원|쏘|도네/;
  // 개수 패턴이 있으면 동작 단어(선물/후원)가 없어도 후원 알림으로 취급 (배너형 대응)
  const AMOUNT_RE = /(?:별풍선|애드벌룬)\s*[\d,]+\s*개|[\d,]+\s*개(?:의)?\s*(?:별풍선|애드벌룬)/;
  function looksLikeDonation(text) {
    return BALLOON_HINT.test(text) && (ACTION_RE.test(text) || AMOUNT_RE.test(text));
  }
  const ROW_SEL = '.chatting-list-item, li, [class*="balloon"], [class*="gift"], [class*="mission"], [class*="item"]';
  const NAME_TXT_SEL = '.username .author, .username, .author, .nickname, .nick';
  const MSG_SEL = '.message-text .msg, .message-text, .msg';

  const seenRows = new WeakSet();
  const recentDonations = [];
  const pendingChat = new Map();
  let collectorStarted = false;

  function isRunning() {
    return !!GM_getValue(K.running, false);
  }

  function donationType(text) {
    if (/애드벌룬/.test(text)) return 'adballoon';
    if (/도전\s*미션|도전미션/.test(text)) return 'challenge';
    if (/대결\s*미션|대결미션/.test(text)) return 'battle';
    return 'balloon';
  }

  function handleDonation(nick, amount, type) {
    const cfg = getCfg();
    if (type === 'balloon' && !cfg.srcBalloon) return;
    if (type === 'challenge' && !cfg.srcChallenge) return;
    if (type === 'battle' && !cfg.srcBattle) return;
    if (type === 'adballoon' && !cfg.srcAdballoon) return;

    const tickets = calcTickets(cfg, amount);
    bumpStats(amount);
    if (tickets <= 0) {
      log(`${nick} 별풍선 ${amount}개 — 기준 미달(티켓 0)`);
      return;
    }

    if (cfg.mode === 'chat') {
      const prev = pendingChat.get(nick);
      pendingChat.set(nick, {
        tickets: (prev ? prev.tickets : 0) + tickets,
        nick,
        expires: Date.now() + Number(cfg.chatWaitSec || 60) * 1000,
      });
      log(`${nick} ${amount}개 → 채팅 대기 (티켓 ${tickets})`);
    } else {
      addEntry(nick, tickets);
      log(`${nick} ${amount}개 → ${nick}*${tickets} 추가`);
    }
  }

  // 여러 알림 형식에서 개수/닉네임 추출. "N번째"(누적 카운트)는 개수로 취급하지 않음.
  function parseDonation(row, text) {
    let amount = null;
    let m = /(?:별풍선|애드벌룬)\s*([\d,]+)\s*개/.exec(text); // "별풍선 100개"
    if (!m) m = /([\d,]+)\s*개(?:의)?\s*(?:별풍선|애드벌룬)/.exec(text); // "100개의 별풍선"
    if (m) amount = parseInt(m[1].replace(/,/g, ''), 10);

    const btn = row.querySelector && row.querySelector('button[user_nick], button[user_id]');
    let nick = btn && (btn.getAttribute('user_nick') || btn.getAttribute('user_id'));
    if (!nick && row.querySelector) {
      const nameEl = row.querySelector(NAME_TXT_SEL);
      if (nameEl) nick = nameEl.textContent;
    }
    if (!nick) {
      const nm = /(.{1,30}?)\s*님(?:이|께서)/.exec(text);
      if (nm) nick = nm[1];
    }
    if (!nick) {
      // 배너형: "강남한이 별풍선 1,000개" — 별풍선 바로 앞 단어를 닉네임으로
      const nm2 = /(\S{1,20})\s*(?:님)?\s*(?:별풍선|애드벌룬)\s*[\d,]+\s*개/.exec(text);
      if (nm2) nick = nm2[1];
    }
    return { nick: cleanNick(nick || ''), amount };
  }

  let lastParseFailLog = 0;

  function processDonationRow(row, text) {
    if (!looksLikeDonation(text)) return false;
    const { nick, amount } = parseDonation(row, text);
    if (!nick || !amount) {
      // 형식을 못 읽은 알림은 원문을 로그로 남겨 형식 파악에 쓴다 (5초 스로틀)
      if (Date.now() - lastParseFailLog > 5000) {
        lastParseFailLog = Date.now();
        log('후원 감지했으나 형식 해석 실패: ' + text.replace(/\s+/g, ' ').slice(0, 90));
      }
      return false;
    }

    const type = donationType(text);

    // 같은 후원이 소켓 + 화면 알림으로 이중 감지될 수 있어 10초 내 동일 건은 1회만
    const key = `${nick}|${amount}|${type}`;
    const now = Date.now();
    while (recentDonations.length && now - recentDonations[0].ts > 10000) recentDonations.shift();
    if (recentDonations.some((d) => d.key === key)) return true;
    recentDonations.push({ key, ts: now });

    handleDonation(nick, amount, type);
    return true;
  }

  function processChatRow(row) {
    if (pendingChat.size === 0) return;
    const btn = row.querySelector('button[user_nick], button[user_id]');
    const nick = cleanNick(
      (btn && (btn.getAttribute('user_nick') || btn.getAttribute('user_id'))) ||
        (row.querySelector(NAME_TXT_SEL) || {}).textContent ||
        ''
    );
    if (!nick || !pendingChat.has(nick)) return;
    const p = pendingChat.get(nick);
    if (Date.now() > p.expires) return;
    const msgEl = row.querySelector(MSG_SEL);
    if (!msgEl) return;
    const cfg = getCfg();
    const msg = extractMsg(msgEl).slice(0, Number(cfg.maxChatLen) || 30);
    if (!msg) return;
    pendingChat.delete(nick);
    addEntry(msg, p.tickets);
    log(`${nick} 채팅 수집 → "${msg}"*${p.tickets}`);
  }

  function processNode(node) {
    if (node.nodeType !== 1) return;
    // 수집기 자신의 설정 패널은 감시 대상에서 제외 (별풍선/후원 단어가 들어 있어 오탐됨)
    if (node.id === 'src-panel' || (node.closest && node.closest('#src-panel'))) return;
    let rows = node.matches && node.matches(ROW_SEL) ? [node] : Array.from(node.querySelectorAll ? node.querySelectorAll(ROW_SEL) : []);
    rows = rows.filter((r) => !(r.closest && r.closest('#src-panel')));
    if (!rows.length && node.textContent && BALLOON_HINT.test(node.textContent)) rows.push(node);
    for (const row of rows) {
      if (seenRows.has(row)) continue;
      seenRows.add(row);
      const text = row.textContent || '';
      const isChatRow = row.matches && row.matches('.chatting-list-item') && row.querySelector(MSG_SEL);
      const looksDonation = looksLikeDonation(text);
      if (isChatRow) {
        // 후원 알림이 채팅 행 형태로 렌더되는 경우: 본문(.msg)이 아닌 행 전체에만
        // 후원 문구가 있으면 후원으로 처리
        const msgText = (row.querySelector(MSG_SEL) || {}).textContent || '';
        if (looksDonation && !looksLikeDonation(msgText)) {
          processDonationRow(row, text);
        } else {
          processChatRow(row);
        }
      } else if (looksDonation) {
        processDonationRow(row, text);
      }
    }
  }

  function startCollector() {
    if (collectorStarted) return;
    collectorStarted = true;

    // 화면(DOM) 긁기 감지는 배너 표시 텍스트("별풍선 998개")를 닉네임으로 오인하는
    // 오탐이 있어 비활성화 — 감지는 웹소켓 후킹(A0)만 사용한다.
    // 필요 시 아래 한 줄을 되살리면 예비 감지가 다시 켜진다.
    // new MutationObserver((muts) => { if (isRunning()) for (const mut of muts) for (const n of mut.addedNodes) processNode(n); }).observe(document.body, { childList: true, subtree: true });

    setInterval(() => {
      if (!isRunning() || pendingChat.size === 0) return;
      const cfg = getCfg();
      const now = Date.now();
      for (const [nick, p] of [...pendingChat]) {
        if (now > p.expires) {
          pendingChat.delete(nick);
          if (cfg.chatFallbackNick) {
            addEntry(nick, p.tickets);
            log(`${nick} 채팅 없음 → 닉네임*${p.tickets} 대체`);
          } else {
            log(`${nick} 채팅 없음 → 버림 (티켓 ${p.tickets})`);
          }
        }
      }
    }, 3000);
  }

  if (document.body) startCollector();
  else document.addEventListener('DOMContentLoaded', startCollector);

  // ---------- 이하 최상위 프레임 전용 (설정 패널 + 게임 창) ----------
  if (window.top !== window.self) return;

  // 게임 창이 살아 있는 세션이면(다른 방송으로 이동하거나 새 탭을 열었을 때) 명단을 지우지 않는다.
  // 게임 창을 가진 탭이 0.5초마다 하트비트를 갱신하므로, 최근 값이 있으면 세션 진행 중으로 본다.
  const _hbTs = GM_getValue(K.heartbeat, 0);
  const _sessionAlive = Date.now() - _hbTs < 4000;
  if (!_sessionAlive) {
    GM_setValue(K.running, false);
    GM_setValue(K.entries, []);
    GM_setValue(K.sync, { ts: Date.now(), text: '' });
    GM_setValue(K.stats, { balloons: 0, events: 0 });
    GM_setValue(K.log, null);
  }

  // ==========================================================
  // B0. 합방 수집 — 선택 멤버 채팅에 직접 접속해 별풍선을 수집
  //     마블 이름 = 시청자 닉네임, 구슬 스킨 = 멤버 프로필(hbNickMember 매핑으로 결정)
  // ==========================================================
  const hbConns = {}; // id -> {ws, ka}
  const hbRecent = []; // 중복 방지 (10초)
  const hbNickMember = {}; // 시청자닉 -> 멤버닉 (프로필 구슬 이미지 매핑용)

  function hbDonation(member, viewer, amount, type) {
    if (!isRunning()) return;
    const cfg = getCfg();
    if (type === 'balloon' && !cfg.srcBalloon) return;
    if (type === 'challenge' && !cfg.srcChallenge) return;
    if (type === 'battle' && !cfg.srcBattle) return;
    if (type === 'adballoon' && !cfg.srcAdballoon) return;
    const key = member.id + '|' + viewer + '|' + amount + '|' + type;
    const now = Date.now();
    while (hbRecent.length && now - hbRecent[0].ts > 10000) hbRecent.shift();
    if (hbRecent.some((d) => d.key === key)) return;
    hbRecent.push({ key, ts: now });
    const tickets = calcTickets(cfg, amount);
    bumpStats(amount);
    if (tickets <= 0) return;
    hbNickMember[viewer] = member.nick; // 프로필 구슬은 이 매핑으로 씌운다
    addEntry(viewer, tickets); // 마블 이름 = 시청자 닉네임만 (멤버는 프로필 이미지로 구분)
    log(member.nick + '방 ' + viewer + ' ' + amount + '개 → ' + viewer + '*' + tickets);
  }

  function hbPacket(member, pk) {
    const svc = parseInt(pk.slice(2, 6), 10);
    const f = pk.split(HB_F);
    if (svc === 18) {
      const v = cleanNick(f[3] || '');
      const a = parseInt(f[4], 10);
      if (v && a > 0) hbDonation(member, v, a, 'balloon');
    } else if (svc === 87) {
      const v = cleanNick(f[4] || '');
      const a = parseInt(f[10], 10);
      if (v && a > 0) hbDonation(member, v, a, 'adballoon');
    } else if (svc === 121) {
      try {
        const j = JSON.parse(f[1]);
        const v = cleanNick(j.user_nick || j.user_id || '');
        const a = Number(j.gift_count) || 0;
        const hint = String(j.mission_type || j.type || '') + ' ' + String(j.title || '');
        const type = /battle|대결/i.test(hint) ? 'battle' : 'challenge';
        if (v && a > 0) hbDonation(member, v, a, type);
      } catch (e) {
        /* JSON 아닌 미션 무시 */
      }
    }
  }

  function hbConnectMember(member) {
    if (hbConns[member.id]) return;
    GM_xmlhttpRequest({
      method: 'POST',
      url: 'https://live.sooplive.co.kr/afreeca/player_live_api.php?bjid=' + member.id,
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      data: 'bid=' + member.id + '&type=live&player_type=html5',
      onload: (res) => {
        let c = null;
        try { c = JSON.parse(res.responseText).CHANNEL; } catch (e) { /* */ }
        if (!c || String(c.RESULT) !== '1') { log(member.nick + ' 방송 중 아님 — 건너뜀'); return; }
        hbOpen(member, c);
      },
      onerror: () => log(member.nick + ' 방송정보 요청 실패'),
    });
  }

  function hbOpen(member, c) {
    if (!isRunning() || !(getCfg().hapbangIds || []).includes(member.id)) return;
    const url = 'wss://' + c.CHDOMAIN + ':' + (parseInt(c.CHPT, 10) + 1) + '/Websocket/' + member.id;
    let ws;
    try { ws = new WebSocket(url, ['chat']); } catch (e) { log(member.nick + ' 소켓 생성 실패'); return; }
    ws.binaryType = 'arraybuffer';
    let joined = false;
    const conn = { ws, ka: null };
    hbConns[member.id] = conn;
    ws.onopen = () => { try { ws.send(hbPkt(1, HB_F + HB_F + HB_F + '16' + HB_F)); } catch (e) {} }; // LOGIN
    ws.onmessage = (ev) => {
      const s = typeof ev.data === 'string' ? ev.data : new TextDecoder('utf-8').decode(ev.data);
      hbSplit(s).forEach((pk) => {
        const svc = pk.slice(2, 6);
        if (svc === '0001' && !joined) {
          joined = true;
          try { ws.send(hbPkt(2, HB_F + String(c.CHATNO) + HB_F + HB_F + HB_F + HB_F + HB_F)); } catch (e) {} // JOIN
          log(member.nick + '방 입장');
          return;
        }
        hbPacket(member, pk);
      });
    };
    ws.onclose = () => {
      if (conn.ka) clearInterval(conn.ka);
      delete hbConns[member.id];
      const cfg = getCfg();
      if (isRunning() && cfg.hapbangOn && (cfg.hapbangIds || []).includes(member.id)) {
        setTimeout(() => hbConnectMember(member), 3000); // 끊기면 재접속
      }
    };
    ws.onerror = () => {};
    conn.ka = setInterval(() => { try { if (ws.readyState === 1) ws.send(hbPkt(0, HB_F)); } catch (e) {} }, 30000); // 킵얼라이브
  }

  function hbStart() {
    const ids = getCfg().hapbangIds || [];
    if (!ids.length) { log('합방 수집: 선택된 멤버가 없습니다'); return; }
    log('합방 수집 시작 — ' + ids.length + '명 접속 시도');
    HAPBANG_MEMBERS.filter((m) => ids.includes(m.id)).forEach((m) => hbConnectMember(m));
  }
  function hbStop() {
    for (const id in hbConns) {
      const c = hbConns[id];
      try { if (c.ka) clearInterval(c.ka); c.ws.close(); } catch (e) {}
      delete hbConns[id];
    }
  }

  // 게임 창에 멤버 프로필 구슬 이미지를 심는다 (합방 모드일 때만)
  function setupGameMarbleImages() {
    if (!gameWin || gameWin.closed) return;
    const cfg = getCfg();
    if (!cfg.hapbangOn) { try { gameWin.__srcMarbleImg = null; } catch (e) {} return; }
    const canvasMap = {}; // 멤버닉 -> 원형 캔버스
    try {
      gameWin.__srcMemberCanvas = canvasMap;
      gameWin.__srcMarbleImg = function (name) {
        const member = hbNickMember[name]; // 시청자닉 → 멤버닉
        return member ? canvasMap[member] || null : null;
      };
    } catch (e) { return; }
    const ids = new Set(cfg.hapbangIds || []);
    HAPBANG_MEMBERS.filter((m) => ids.has(m.id)).forEach((m) => {
      GM_xmlhttpRequest({
        method: 'GET', url: m.img, responseType: 'blob',
        onload: (res) => {
          try {
            const objUrl = URL.createObjectURL(res.response); // blob: → 같은 출처 → taint 없음
            const img = new gameWin.Image();
            img.onload = function () {
              try {
                const S = 128;
                const cv = gameWin.document.createElement('canvas');
                cv.width = S; cv.height = S;
                const g = cv.getContext('2d');
                g.beginPath(); g.arc(S / 2, S / 2, S / 2, 0, 2 * Math.PI); g.closePath(); g.clip();
                const side = Math.min(img.naturalWidth, img.naturalHeight) || S;
                const sx = (img.naturalWidth - side) / 2, sy = (img.naturalHeight - side) / 2;
                g.drawImage(img, sx, sy, side, side, 0, 0, S, S);
                canvasMap[m.nick] = cv;
              } catch (e) {}
              URL.revokeObjectURL(objUrl);
            };
            img.onerror = function () { URL.revokeObjectURL(objUrl); log(m.nick + ' 프로필 이미지 로드 실패'); };
            img.src = objUrl;
          } catch (e) {}
        },
        onerror: () => log(m.nick + ' 프로필 이미지 요청 실패'),
      });
    });
  }

  // ==========================================================
  // C. 내장 핀볼 게임 (Marble Roulette 전체를 단일 HTML로 내장)
  // ==========================================================
  // 게임 HTML은 gzip+base64로 내장 — 실행 시 브라우저 내장 해제(DecompressionStream)로 푼다
  const GAME_GZ_B64 = '';

  let gameHtmlCache = null;
  async function gameHtml() {
    if (gameHtmlCache) return gameHtmlCache;
    const bin = atob(GAME_GZ_B64);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    const stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));
    const buf = await new Response(stream).arrayBuffer();
    gameHtmlCache = new TextDecoder('utf-8').decode(buf);
    return gameHtmlCache;
  }

  let gameWin = null;

  function openGame() {
    if (gameWin && !gameWin.closed) {
      gameWin.focus();
      return;
    }
    // 클릭 제스처가 유지되는 동안 동기로 창부터 연다 (팝업 차단 회피)
    gameWin = window.open('', 'src_game', 'width=1300,height=850');
    if (!gameWin) {
      log('팝업이 차단되어 게임 창을 못 열었습니다');
      return;
    }
    gameWin.document.write(
      '<title>버먼</title><body style="background:#14161d;color:#8a90a3;' +
        'font:14px sans-serif;display:grid;place-items:center;height:100vh;margin:0">게임 로딩 중…</body>'
    );
    gameHtml()
      .then((html) => {
        if (!gameWin || gameWin.closed) return;
        const doc = gameWin.document;
        doc.open();
        doc.write(html);
        doc.close();
        armCloseGuard();
        try { setupGameMarbleImages(); } catch (e) { log('프로필 구슬 설정 실패: ' + e.message); }
        waitAndPush();
      })
      .catch((e) => log('게임 로드 실패: ' + e.message));
  }

  // 게임 창을 닫으면 게임이 완전히 종료됨 — 닫기 전 브라우저 확인 창을 띄운다
  function armCloseGuard() {
    if (!gameWin || gameWin.closed) return;
    try {
      gameWin.onbeforeunload = getCfg().confirmClose
        ? function (e) {
            e.preventDefault();
            e.returnValue = '';
            return '';
          }
        : null;
    } catch (e) {
      /* ignore */
    }
  }

  // 게임 로드(물리엔진 준비) 후 현재 목록을 밀어넣는다
  function waitAndPush() {
    let pushes = 0;
    let waited = 0;
    const t = setInterval(() => {
      if (!gameWin || gameWin.closed) {
        clearInterval(t);
        return;
      }
      if ((waited += 700) > 30000) {
        clearInterval(t);
        log('게임 준비 대기 시간 초과 — 게임 창을 닫고 다시 열어보세요');
        return;
      }
      try {
        if (gameWin.roulette && gameWin.roulette.isReady) {
          hookGameStart();
          pushToGame(true);
          // 이벤트 리스너 부착 타이밍과의 경합 대비, 준비 후 2회 더 강제 반영
          if (++pushes >= 3) clearInterval(t);
        }
      } catch (e) {
        /* 창 전환 중 접근 실패 무시 */
      }
    }, 700);
  }

  let lastPushErrLog = 0;
  function pushToGame(force) {
    if (!gameWin || gameWin.closed) return;
    try {
      const ta = gameWin.document.querySelector('#in_names');
      if (!ta) {
        // 게임이 아직 로딩 중 — 다음 주기에 다시 시도된다
        if (Date.now() - lastPushErrLog > 5000) {
          lastPushErrLog = Date.now();
          log('게임 입력칸 준비 대기 중…');
        }
        return;
      }
      const text = buildText(getEntries());
      if (!force && ta.value === text) return;
      ta.value = text;
      ta.dispatchEvent(new gameWin.Event('input', { bubbles: true }));
    } catch (e) {
      if (Date.now() - lastPushErrLog > 5000) {
        lastPushErrLog = Date.now();
        log('게임 입력 실패: ' + e.message);
      }
    }
  }

  // 게임에서 구슬 굴리기(시작)를 누르면 마감을 누르지 않았어도 자동으로 마감한다.
  // (마감하지 않으면 경주 도중 들어온 후원이 입력칸을 덮어써 게임이 리셋된다)
  let onCollectionEnd = null; // 설정 패널이 채워 넣는 후처리(타이머 해제 + 상태 갱신)

  function endCollection(reason) {
    if (!isRunning()) return;
    GM_setValue(K.running, false);
    finalizeCollection();
    if (onCollectionEnd) onCollectionEnd();
    log(reason);
  }

  function hookGameStart() {
    if (!gameWin || gameWin.closed) return;
    try {
      const btn = gameWin.document.querySelector('#btnStart');
      if (!btn || btn.__srcHooked) return;
      btn.__srcHooked = true;
      // 캡처 단계에서 먼저 마감해, 경주가 시작되기 전에 명단을 확정한다
      btn.addEventListener('click', () => endCollection('게임 시작 — 자동 마감'), true);
    } catch (e) {
      /* ignore */
    }
  }

  // 마감 시: 채팅 대기 중이던 후원을 설정대로 확정하고 게임에 최종 반영한다.
  // (마감 후에는 어떤 후원도 새로 들어오지 않는다)
  function finalizeCollection() {
    hbStop();
    const cfg = getCfg();
    for (const [nick, p] of [...pendingChat]) {
      pendingChat.delete(nick);
      if (cfg.chatFallbackNick) {
        addEntry(nick, p.tickets);
        log(`${nick} 채팅 없음 → 닉네임*${p.tickets} 확정`);
      }
    }
    pushToGame(true);
  }

  // ==========================================================
  // D. 설정 패널
  // ==========================================================
  function buildPanel() {

  const css = `
  #src-panel{--bg:#1c1e24;--card:#23262d;--bd:#31343d;--txt:#d8dade;--mut:#83878f;
    --acc:#3e5fd6;--ok:#48b978;--bad:#d4555a;
    position:fixed;right:20px;bottom:20px;z-index:2147483000;width:308px;
    background:var(--bg);color:var(--txt);border:1px solid var(--bd);border-radius:8px;
    font:13px/1.6 'Malgun Gothic',system-ui,sans-serif;
    box-shadow:0 6px 20px rgba(0,0,0,.4);user-select:none;max-height:96vh;overflow:hidden;}
  #src-panel *{box-sizing:border-box;font:inherit;color:inherit;}
  #src-panel .hd{display:flex;align-items:center;gap:8px;padding:10px 12px;cursor:move;
    border-bottom:1px solid var(--bd);}
  #src-panel .hd .ttl{font-weight:700;}
  #src-panel .st{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--mut);}
  #src-panel .st i{width:7px;height:7px;border-radius:50%;background:#4a4e58;}
  #src-panel .st.on{color:var(--ok);}
  #src-panel .st.on i{background:var(--ok);}
  #src-panel .hd .sp{flex:1}
  #src-panel .hd button{background:none;border:0;cursor:pointer;width:22px;height:22px;
    border-radius:4px;color:var(--mut);font-size:12px;line-height:1;}
  #src-panel .hd button:hover{background:var(--card);color:var(--txt);}
  #src-panel .bd{padding:12px;display:flex;flex-direction:column;gap:9px;}
  #src-panel .seg{display:flex;background:#15171c;border:1px solid var(--bd);
    border-radius:6px;padding:2px;gap:2px;}
  #src-panel .seg button{flex:1;border:0;background:none;color:var(--mut);padding:5px 0;
    border-radius:4px;cursor:pointer;}
  #src-panel .seg button.on{background:var(--acc);color:#fff;}
  #src-panel .card{background:var(--card);border:1px solid var(--bd);border-radius:6px;
    padding:9px 11px;}
  #src-panel .lbl{font-size:11px;color:var(--mut);margin-bottom:5px;}
  #src-panel .chips{display:flex;gap:5px;flex-wrap:wrap;}
  #src-panel .chip{flex:1 1 45%;}
  #src-panel .chip input{display:none;}
  #src-panel .chip span{display:block;text-align:center;padding:4px 0;border-radius:5px;
    border:1px solid var(--bd);background:#15171c;color:var(--mut);cursor:pointer;
    font-size:12px;}
  #src-panel .chip input:checked+span{border-color:var(--acc);color:var(--txt);
    background:rgba(62,95,214,.14);}
  #src-panel .frow{display:flex;align-items:center;gap:5px;margin:2px 0;
    white-space:nowrap;}
  #src-panel .frow.sm{font-size:12px;gap:4px;}
  #src-panel .frow.sm input[type=number]{width:58px;}
  #src-panel input[type=number]{width:62px;background:#15171c;border:1px solid var(--bd);
    border-radius:5px;padding:1px 6px;text-align:right;outline:none;}
  #src-panel input:focus{border-color:var(--acc);}
  #src-panel .sw{position:relative;display:inline-block;width:30px;height:17px;flex:none;}
  #src-panel .sw input{display:none;}
  #src-panel .sw i{position:absolute;inset:0;background:#3a3e48;border-radius:99px;
    cursor:pointer;transition:background .15s;}
  #src-panel .sw i:before{content:'';position:absolute;top:2px;left:2px;width:13px;
    height:13px;background:#878b94;border-radius:50%;transition:all .15s;}
  #src-panel .sw input:checked+i{background:var(--acc);}
  #src-panel .sw input:checked+i:before{left:15px;background:#fff;}
  #src-panel .hint{color:var(--mut);font-size:11px;margin-top:3px;}
  #src-panel .actions{display:flex;gap:7px;margin-top:2px;}
  #src-panel .actions button{flex:1;border:1px solid var(--bd);border-radius:6px;
    padding:8px 0;cursor:pointer;font-weight:700;background:var(--card);color:var(--mut);}
  #src-panel .actions button:disabled{opacity:.38;cursor:default;pointer-events:none;}
  #src-panel .actions .primary{background:var(--acc);border-color:var(--acc);color:#fff;}
  #src-panel .actions .primary:hover{background:#4a6ce0;}
  #src-panel .actions .danger:hover{color:var(--bad);border-color:#4a3236;}
  #src-area{position:relative;display:flex;flex-direction:column;gap:9px;}
  #src-lock{position:absolute;inset:-4px;z-index:5;display:none;cursor:not-allowed;}
  #src-panel.locked #src-lock{display:block;}
  #src-panel.locked #src-area > .seg,
  #src-panel.locked #src-area > .card{opacity:.45;}
  #src-lock span{display:none;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
    background:rgba(10,11,14,.95);color:#dcdee3;padding:7px 14px;border-radius:7px;
    font-size:12px;white-space:nowrap;border:1px solid #3a3f4c;box-shadow:0 4px 14px rgba(0,0,0,.4);}
  #src-lock:hover span{display:block;}
  #src-panel .card.off{opacity:.35;pointer-events:none;}
  #src-panel.windowed{position:static;right:auto;bottom:auto;width:100%;min-height:100vh;
    border:0;border-radius:0;box-shadow:none;}
  #src-panel.windowed .hd{cursor:default;}
  #src-panel.windowed .hd button{display:none;}
  #src-panel.windowed .bd{max-height:none;}
  #src-panel.windowed{overflow:visible;}
  #src-panel #src-seg button{font-size:12px;padding:5px 2px;}
  #src-panel #src-hapbang-members .chip{flex:1 1 30%;}
  #src-panel #src-hapbang-members .chip span{padding:3px 0;font-size:11px;}
  #src-panel .mini{background:#15171c;border:1px solid var(--bd);color:var(--mut);
    border-radius:5px;padding:2px 10px;cursor:pointer;font-size:11px;}
  #src-panel .mini:hover{color:var(--txt);border-color:var(--acc);}
  #src-panel .bd{scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.2) transparent;}
  #src-panel .bd::-webkit-scrollbar{width:8px;height:8px;}
  #src-panel .bd::-webkit-scrollbar-track{background:transparent;}
  #src-panel .bd::-webkit-scrollbar-thumb{background:rgba(255,255,255,.16);border-radius:8px;}
  #src-panel .bd::-webkit-scrollbar-thumb:hover{background:rgba(255,255,255,.3);}
  #src-panel.hapbang:not(.windowed) .bd{max-height:78vh;overflow-y:auto;}
  `;
  const PANEL_HTML = `
    <div class="hd">
      <span class="ttl">핀볼게임 수집기</span>
      <span class="st" id="src-st"><i></i><span>대기</span></span>
      <span class="sp"></span>
      <button id="src-min" title="접기">–</button>
      <button id="src-close" title="닫기">✕</button>
    </div>
    <div class="bd">
      <div id="src-area">
      <div class="seg" id="src-seg">
        <button data-v="nick">닉네임 수집</button>
        <button data-v="chat">채팅 수집</button>
        <button data-v="hapbang">합방 수집</button>
      </div>
      <div class="card" id="src-hapbang-card" style="display:none">
        <div class="lbl">수집할 멤버 <span id="src-hapbang-count"></span></div>
        <div class="chips" id="src-hapbang-members"></div>
        <div class="frow sm" style="margin-top:6px;gap:6px">
          <button type="button" id="src-hapbang-all" class="mini">전체</button>
          <button type="button" id="src-hapbang-none" class="mini">해제</button>
        </div>
        <div class="hint">구슬 = 멤버 프로필 · 이름 = 시청자 닉네임</div>
      </div>
      <div class="card">
        <div class="lbl">수집 대상</div>
        <div class="chips">
          <label class="chip"><input type="checkbox" id="src-balloon"><span>별풍선</span></label>
          <label class="chip"><input type="checkbox" id="src-challenge"><span>도전미션</span></label>
          <label class="chip"><input type="checkbox" id="src-battle"><span>대결미션</span></label>
          <label class="chip"><input type="checkbox" id="src-adballoon"><span>애드벌룬</span></label>
        </div>
      </div>
      <div class="card">
        <div class="lbl">티켓 계산</div>
        <div class="frow">별풍선 <input type="number" id="src-per" min="1"> 개당 티켓 1개</div>
        <div class="frow sm"><label class="sw"><input type="checkbox" id="src-bonus-on"><i></i></label>
          보너스: 티켓 <input type="number" id="src-bonus-every" min="1">개당 +<input type="number" id="src-bonus-add" min="1">개</div>
        <div class="hint" id="src-preview"></div>
      </div>
      <div class="card" id="src-chatopt">
        <div class="lbl">채팅 수집 옵션</div>
        <div class="frow">후원 후 채팅 대기 <input type="number" id="src-wait" min="5"> 초</div>
        <div class="frow sm"><label class="sw"><input type="checkbox" id="src-fallback"><i></i></label>
          채팅 없으면 닉네임으로 대체</div>
      </div>
      <div class="card">
        <div class="lbl">수집 타이머</div>
        <div class="frow sm"><label class="sw"><input type="checkbox" id="src-timer-on"><i></i></label>
          <input type="number" id="src-timer-min" min="0" max="180"> 분
          <input type="number" id="src-timer-sec" min="0" max="59"> 초 동안</div>
        <div class="hint" id="src-timer-left" style="display:none"></div>
      </div>
      <div class="card">
        <div class="frow sm"><label class="sw"><input type="checkbox" id="src-confirm-close"><i></i></label>
          게임 창 닫기 전에 확인</div>
        <div class="frow sm"><label class="sw"><input type="checkbox" id="src-sim"><i></i></label>
          테스트: 랜덤 별풍선 자동 발사</div>
      </div>
      <div id="src-lock"><span>게임 창을 닫은 후 다시 설정하세요</span></div>
      </div>
      <div class="actions">
        <button id="src-btn-start" class="primary">수집 시작</button>
        <button id="src-btn-stop" class="danger">마감</button>
      </div>
      <div class="card" style="margin-top:9px">
        <div class="lbl">로그</div>
        <div id="src-log" style="max-height:110px;overflow:auto;font-size:11px;line-height:1.5;color:var(--mut);white-space:pre-wrap;word-break:break-all"></div>
      </div>
    </div>`;

  let panel = null;      // 현재 마운트된 설정 패널
  let panelWin = null;   // 설정 전용 팝업 창
  const $ = (sel) => (panel ? panel.querySelector(sel) : null);

  function mountPanel(doc, windowed) {
    const st = doc.createElement('style');
    st.textContent = css;
    doc.head.appendChild(st);
    const el = doc.createElement('div');
    el.id = 'src-panel';
    if (windowed) el.classList.add('windowed');
    el.innerHTML = PANEL_HTML;
    doc.body.appendChild(el);
    panel = el;
    buildHapbangChips();
    wirePanel(doc, windowed);
    loadCfgToUI();
    renderState();
    renderLog();
  }

  // 설정을 별도 창으로 — 방송 화면 위로 겹쳐 못 움직이는 문제를 원천 차단
  function openSettings() {
    if (panelWin && !panelWin.closed) {
      panelWin.focus();
      return;
    }
    panelWin = window.open('', 'src_settings', 'width=360,height=640');
    if (!panelWin) {
      mountInPage(); // 팝업 차단 시 페이지 안에 표시
      return;
    }
    const d = panelWin.document;
    d.open();
    d.write(
      '<!doctype html><meta charset="utf-8"><title>핀볼게임 수집기</title>' +
        '<style>html,body{margin:0;padding:0;background:#1c1e24;overflow-x:hidden}</style><body></body>'
    );
    d.close();
    mountPanel(d, true);
    fitSettingsWindow();
    panelWin.addEventListener('beforeunload', () => {
      panel = null;
    });
  }

  // 설정 창을 콘텐츠 높이에 맞춰 정확히 줄인다 (남는 여백/스크롤 방지)
  function fitSettingsWindow() {
    if (!panelWin || panelWin.closed || !panel) return;
    const apply = () => {
      try {
        const hd = panel.querySelector('.hd');
        const bd = panel.querySelector('.bd');
        if (!hd || !bd) return;
        const hc = panel.querySelector('#src-hapbang-card');
        const hapbang = uiMode === 'hapbang';
        // 모든 모드 동일 크기: 합방 카드를 뺀 '기준' 콘텐츠 높이로 창을 맞춘다
        const prevDisp = hc ? hc.style.display : null;
        if (hc) hc.style.display = 'none';
        bd.style.maxHeight = 'none';
        const baseBodyH = bd.scrollHeight;
        if (hc) hc.style.display = prevDisp;
        const baseContentH = hd.offsetHeight + baseBodyH;
        const chromeH = panelWin.outerHeight - panelWin.innerHeight;
        const chromeW = panelWin.outerWidth - panelWin.innerWidth;
        panelWin.resizeTo(360 + chromeW, baseContentH + chromeH);
        // 합방 모드에선 넘치는 내용을 본문 안에서 스크롤 (창 크기는 그대로)
        if (hapbang) {
          bd.style.maxHeight = baseBodyH + 'px';
          bd.style.overflowY = 'auto';
        } else {
          bd.style.maxHeight = 'none';
          bd.style.overflowY = '';
        }
      } catch (e) {
        /* ignore */
      }
    };
    // 레이아웃이 끝난 뒤 측정
    panelWin.requestAnimationFrame(() => panelWin.requestAnimationFrame(apply));
  }

  function mountInPage() {
    if (panel && panel.isConnected && panel.ownerDocument === document) {
      panel.style.display = '';
      return;
    }
    mountPanel(document, false);
  }

  function toggleSettings() {
    if (panelWin && !panelWin.closed) {
      panelWin.close();
      panelWin = null;
      panel = null;
      return;
    }
    openSettings();
  }
  GM_registerMenuCommand('🎮 설정 창 열기/닫기', toggleSettings);

  // ----- 설정 로드/저장 -----
  let uiMode = 'nick';
  function applyModeUI() {
    if (!panel) return;
    panel.querySelectorAll('#src-seg button').forEach((b) => b.classList.toggle('on', b.dataset.v === uiMode));
    // 채팅 옵션은 자리를 지킨 채 비활성화만 한다
    $('#src-chatopt').classList.toggle('off', uiMode !== 'chat');
    // 합방 수집 모드일 때만 멤버 선택 칩을 보여준다
    const hc = $('#src-hapbang-card');
    if (hc) hc.style.display = uiMode === 'hapbang' ? '' : 'none';
    panel.classList.toggle('hapbang', uiMode === 'hapbang');
    applyHapbangUI();
    fitSettingsWindow();
  }
  function buildHapbangChips() {
    const box = panel && panel.querySelector('#src-hapbang-members');
    if (!box) return;
    box.innerHTML = HAPBANG_MEMBERS.map((m) =>
      '<label class="chip"><input type="checkbox" class="hb-mem" value="' + m.id + '"><span>' + m.nick + '</span></label>'
    ).join('');
  }
  function applyHapbangUI() {
    if (!panel) return;
    const n = panel.querySelectorAll('.hb-mem:checked').length;
    const cnt = $('#src-hapbang-count');
    if (cnt) cnt.textContent = '(' + n + '명)';
  }
  function loadCfgToUI() {
    if (!panel) return;
    const cfg = getCfg();
    uiMode = cfg.mode;
    $('#src-balloon').checked = cfg.srcBalloon;
    $('#src-challenge').checked = cfg.srcChallenge;
    $('#src-battle').checked = cfg.srcBattle;
    $('#src-adballoon').checked = cfg.srcAdballoon;
    $('#src-per').value = cfg.perTicket;
    $('#src-bonus-on').checked = cfg.bonusOn;
    $('#src-bonus-every').value = cfg.bonusEvery;
    $('#src-bonus-add').value = cfg.bonusAdd;
    $('#src-wait').value = cfg.chatWaitSec;
    $('#src-fallback').checked = cfg.chatFallbackNick;
    $('#src-timer-on').checked = cfg.timerOn;
    $('#src-timer-min').value = cfg.timerMin;
    $('#src-timer-sec').value = cfg.timerSec;
    $('#src-confirm-close').checked = cfg.confirmClose;
    $('#src-sim').checked = cfg.simOn;
    const hbids = new Set(cfg.hapbangIds || []);
    panel.querySelectorAll('.hb-mem').forEach((cb) => { cb.checked = hbids.has(cb.value); });
    applyModeUI();
    renderPreview(cfg);
  }
  function saveCfgFromUI() {
    if (!panel) return;
    const cfg = getCfg();
    cfg.mode = uiMode;
    cfg.srcBalloon = $('#src-balloon').checked;
    cfg.srcChallenge = $('#src-challenge').checked;
    cfg.srcBattle = $('#src-battle').checked;
    cfg.srcAdballoon = $('#src-adballoon').checked;
    cfg.perTicket = Math.max(1, Number($('#src-per').value) || 1);
    cfg.bonusOn = $('#src-bonus-on').checked;
    cfg.bonusEvery = Math.max(1, Number($('#src-bonus-every').value) || 1);
    cfg.bonusAdd = Math.max(1, Number($('#src-bonus-add').value) || 1);
    cfg.chatWaitSec = Math.max(5, Number($('#src-wait').value) || 60);
    cfg.chatFallbackNick = $('#src-fallback').checked;
    cfg.timerOn = $('#src-timer-on').checked;
    cfg.timerMin = Math.max(0, Number($('#src-timer-min').value) || 0);
    cfg.timerSec = Math.min(59, Math.max(0, Number($('#src-timer-sec').value) || 0));
    cfg.confirmClose = $('#src-confirm-close').checked;
    cfg.simOn = $('#src-sim').checked;
    cfg.hapbangOn = uiMode === 'hapbang';
    cfg.hapbangIds = Array.from(panel.querySelectorAll('.hb-mem:checked')).map((cb) => cb.value);
    GM_setValue(K.cfg, cfg);
    armCloseGuard();
    renderPreview(cfg);
    applyHapbangUI();
  }
  function renderPreview(cfg) {
    if (!panel) return;
    const sample = 2000;
    const per = Math.max(1, Number(cfg.perTicket) || 1);
    const base = Math.floor(sample / per);
    const total = calcTickets(cfg, sample);
    const bonus = total - base;
    const bonusTxt = cfg.bonusOn
      ? ` · 보너스 티켓 ${Number(cfg.bonusEvery)}개당 +${Number(cfg.bonusAdd)} (여기선 +${bonus})`
      : ' · 보너스 꺼짐';
    $('#src-preview').textContent = `예시: ${sample}개 → 기본 ${base} + 보너스 ${bonus} = 티켓 ${total}개${bonusTxt}`;
  }

  // ----- 상태 표시 -----
  // 수집 중에는 시작 버튼을 잠그고, 게임 창이 열려 있는 동안에는 설정 전체를 잠근다.
  function renderState() {
    if (!panel) return;
    const on = isRunning();
    const gameOpen = !!gameWin && !gameWin.closed;
    const st = $('#src-st');
    st.querySelector('span').textContent = on ? '수집 중' : '대기';
    st.classList.toggle('on', on);
    $('#src-btn-start').disabled = on;
    $('#src-btn-stop').disabled = !on;
    panel.classList.toggle('locked', gameOpen);
  }
  function renderLog() {
    const el = $('#src-log');
    if (!el) return;
    let list = GM_getValue(K.log, []);
    if (!Array.isArray(list)) list = [];
    const pad = (n) => String(n).padStart(2, '0');
    el.textContent = list.slice(-14).map((e) => {
      const d = new Date(e.ts);
      return pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds()) + '  ' + e.msg;
    }).join('\n');
    el.scrollTop = el.scrollHeight;
  }

  // 게임 창을 닫으면 그 판은 끝 — 수집을 멈추고 명단도 비운다.
  // (닫기 전에 확인 창으로 경고하므로, 닫았다는 건 판을 버리겠다는 뜻)
  let gameWasOpen = false;
  function watchGameWindow() {
    const open = !!gameWin && !gameWin.closed;
    if (open) hookGameStart(); // 이미 걸려 있으면 즉시 반환 — 놓친 경우 대비

    if (gameWasOpen && !open) {
      hbStop();
      gameWin = null;
      deadline = null;
      pendingChat.clear();
      GM_setValue(K.running, false);
      GM_setValue(K.entries, []);
      GM_setValue(K.stats, { balloons: 0, events: 0 });
      GM_setValue(K.sync, { ts: Date.now(), text: '' });
      renderState();
    }
    gameWasOpen = open;
  }

  // ----- 수집 타이머 -----
  let deadline = null; // 수집 종료 예정 시각

  // 게임 시작/마감 등 외부 경로로 수집이 끝났을 때의 후처리
  onCollectionEnd = () => {
    deadline = null;
    tickTimer();
    renderState();
  };

  function tickTimer() {
    const el = $('#src-timer-left');
    if (deadline === null) {
      if (el) el.style.display = 'none';
      return;
    }
    const left = deadline - Date.now();
    if (left <= 0) {
      deadline = null;
      if (el) el.style.display = 'none';
      GM_setValue(K.running, false);
      finalizeCollection();
      log('설정한 시간 종료 — 수집 마감');
      renderState();
      return;
    }
    if (!el) return;
    const s = Math.ceil(left / 1000);
    el.style.display = '';
    el.textContent = `남은 시간 ${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  }

  // ----- 패널 이벤트 연결 (설정 창을 열 때마다 실행) -----
  function wirePanel(doc, windowed) {
    const win = doc.defaultView;

    panel.querySelectorAll('#src-seg button').forEach((b) =>
      b.addEventListener('click', () => {
        uiMode = b.dataset.v;
        applyModeUI();
        saveCfgFromUI();
      })
    );
    panel.querySelectorAll('input').forEach((el) => el.addEventListener('change', saveCfgFromUI));

    const hbAll = $('#src-hapbang-all'), hbNone = $('#src-hapbang-none');
    if (hbAll) hbAll.addEventListener('click', () => { panel.querySelectorAll('.hb-mem').forEach((cb) => (cb.checked = true)); saveCfgFromUI(); });
    if (hbNone) hbNone.addEventListener('click', () => { panel.querySelectorAll('.hb-mem').forEach((cb) => (cb.checked = false)); saveCfgFromUI(); });

    // 수집 시작: 이전 목록을 비우고 게임 창을 새로 연 뒤, 마감 전까지 채팅에서 긁어 게임에 쌓는다
    $('#src-btn-start').addEventListener('click', () => {
      if (isRunning()) return;
      saveCfgFromUI();
      const cfg = getCfg();
      GM_setValue(K.entries, []);
      GM_setValue(K.stats, { balloons: 0, events: 0 });
      GM_setValue(K.sync, { ts: Date.now(), text: '' });
      GM_setValue(K.log, null);
      GM_setValue(K.running, true);
      if (cfg.timerOn) {
        const total = cfg.timerMin * 60 + cfg.timerSec;
        deadline = total > 0 ? Date.now() + total * 1000 : null;
      } else {
        deadline = null;
      }
      log('수집 시작');
      renderState();
      openGame();
      if (cfg.hapbangOn) hbStart();
    });
    $('#src-btn-stop').addEventListener('click', () => {
      endCollection('수집 마감');
    });

    // ----- 접기/닫기/드래그 (페이지 내 표시일 때만 의미 있음) -----
    $('#src-min').addEventListener('click', () => {
      const bd = panel.querySelector('.bd');
      bd.style.display = bd.style.display === 'none' ? '' : 'none';
    });
    $('#src-close').addEventListener('click', () => {
      if (windowed) win.close();
      else panel.style.display = 'none';
    });
    if (windowed) return;
    (function drag() {
      const hd = panel.querySelector('.hd');
      let sx, sy, sr, sb, on = false;
      hd.addEventListener('mousedown', (e) => {
        if (e.target.tagName === 'BUTTON') return;
        on = true;
        sx = e.clientX; sy = e.clientY;
        const r = panel.getBoundingClientRect();
        sr = win.innerWidth - r.right; sb = win.innerHeight - r.bottom;
        e.preventDefault();
      });
      win.addEventListener('mousemove', (e) => {
        if (!on) return;
        panel.style.right = Math.max(0, sr - (e.clientX - sx)) + 'px';
        panel.style.bottom = Math.max(0, sb - (e.clientY - sy)) + 'px';
      });
      win.addEventListener('mouseup', () => (on = false));
    })();
  }


  // ----- 다른 프레임/탭 변경 반영 + 게임 창 실시간 푸시 -----
  // ----- 테스트: 랜덤 별풍선 자동 발사 (임시 기능) -----
  const SIM_NICKS = ['별빛여우', '초코송이', '민트라떼', '달리는꾸미', '시원한바람', '토마토킹', '야옹이집사', '럭키가이', '붕어빵장인', '네온참치'];
  const SIM_PHRASES = ['오늘도 화이팅', '1등 가즈아', '치킨 사주세요', '사랑해요 방장님', '복권 당첨 기원', '드디어 왔다', '자리 맡아주세요', '노래 신청이요'];
  const SIM_AMOUNTS = [100, 100, 200, 300, 500, 500, 1000, 1000, 2000, 5000, 10000];

  function fireSimDonation() {
    const cfg = getCfg();
    if (!isRunning() || !cfg.simOn) return;
    const types = [];
    if (cfg.srcBalloon) types.push('balloon');
    if (cfg.srcChallenge) types.push('challenge');
    if (cfg.srcBattle) types.push('battle');
    if (!types.length) return;
    let nick = SIM_NICKS[(Math.random() * SIM_NICKS.length) | 0];
    if (Math.random() < 0.4) nick += String((Math.random() * 99) | 0);
    const amount = SIM_AMOUNTS[(Math.random() * SIM_AMOUNTS.length) | 0];
    handleDonation(nick, amount, types[(Math.random() * types.length) | 0]);
    // 채팅 모드면 1.5~4.5초 뒤 80% 확률로 그 사람이 채팅을 친 것처럼 처리
    if (cfg.mode === 'chat') {
      setTimeout(() => {
        const p = pendingChat.get(nick);
        if (!p || Math.random() >= 0.8) return;
        pendingChat.delete(nick);
        addEntry(SIM_PHRASES[(Math.random() * SIM_PHRASES.length) | 0], p.tickets);
      }, 1500 + Math.random() * 3000);
    }
  }
  (function simLoop() {
    setTimeout(() => {
      fireSimDonation();
      simLoop();
    }, 2500 + Math.random() * 5000);
  })();

  GM_addValueChangeListener(K.entries, () => pushToGame(false));
  GM_addValueChangeListener(K.running, renderState);
  GM_addValueChangeListener(K.log, renderLog);

  // 자기교정 동기화: 게임 입력칸의 실제 값을 목록과 대조해 다르면 즉시 바로잡는다.
  // (값이 바뀐 순간 한 번만 시도하면, 그때 게임이 준비 전이었을 경우 영영 누락된다)
  // 수집 중일 때만 강제한다 — 마감 후에는 사용자가 직접 편집할 수 있어야 하므로.
  setInterval(() => {
    if (isRunning()) pushToGame(false);
  }, 1000);

  // 타이머 카운트다운 + 게임 창 열림/닫힘 상태 갱신
  setInterval(() => {
    watchGameWindow();
    tickTimer();
    renderState();
    renderLog();
    if (gameWin && !gameWin.closed) GM_setValue(K.heartbeat, Date.now()); // 세션 하트비트
  }, 500);

  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', buildPanel);
  else buildPanel();
})();